{
  "name": "react-render-detective",
  "version": "0.6.0",
  "description": "Know WHY your React components render — not just that they did.",
  "keywords": [
    "react",
    "render",
    "performance",
    "debug",
    "devtools",
    "profiler",
    "re-render",
    "memo"
  ],
  "license": "MIT",
  "author": "shubambhasin",
  "homepage": "https://shubambhasin.github.io/react-render-detective/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shubambhasin/react-render-detective.git"
  },
  "bugs": {
    "url": "https://github.com/shubambhasin/react-render-detective/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./overlay": {
      "types": "./dist/overlay.d.ts",
      "import": "./dist/overlay.js",
      "require": "./dist/overlay.cjs"
    },
    "./babel": {
      "types": "./dist/babel.d.ts",
      "import": "./dist/babel.js",
      "require": "./dist/babel.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./interactions": {
      "types": "./dist/interactions.d.ts",
      "import": "./dist/interactions.js",
      "require": "./dist/interactions.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "npm run build && node scripts/size.mjs",
    "bench": "node bench/run.mjs",
    "prepublishOnly": "npm run build && node scripts/verify-package.mjs && node scripts/changelog.mjs --check",
    "verify": "node scripts/verify-package.mjs",
    "use-local": "node scripts/use-local.mjs",
    "changelog:check": "node scripts/changelog.mjs --check",
    "changelog:html": "node scripts/changelog.mjs --html",
    "version": "node scripts/changelog.mjs --start $npm_package_version && node scripts/sync-version.mjs && git add CHANGELOG.md README.md site/index.html"
  },
  "peerDependencies": {
    "react": ">=16.9.0",
    "@babel/core": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "@babel/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@testing-library/react": "^16.1.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.4.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
